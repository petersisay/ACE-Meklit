PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ace_meklit
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Chapa Payment Gateway Configuration (Trial / Production)
# Register at https://chapa.co to get test keys
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# Administrator Credentials (Optional: configure custom admin on initial setup)
ADMIN_EMAIL=admin@acemeklit.org
ADMIN_PASSWORD=your_secure_admin_password_here
