# ========================================================
# ACE Meklit — Production & Development Environment Template
# ========================================================

# Server Configuration (Render)
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ace_meklit?retryWrites=true&w=majority
JWT_SECRET=your_strong_jwt_production_secret_key
CLIENT_URL=https://your-frontend.vercel.app

# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# Frontend Configuration (Vercel)
VITE_API_URL=https://ace-meklit.onrender.com
